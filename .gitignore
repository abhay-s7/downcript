# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# PyInstaller-frozen transcription binaries for the desktop build (see
# scripts/build-python.sh) -- rebuilt as needed, not committed.
/build-python

# Bundled yt-dlp standalone binary for the desktop build (see
# scripts/download-yt-dlp.sh) -- redownloaded as needed, not committed.
/vendor

# electron-builder output (packaged .app / .dmg) -- rebuilt via `npm run
# dist:mac`, not committed.
/dist-electron

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
